name: "iOSGods IPA 链接抓取"
desc: "拦截 iOSGods 下载接口响应，提取 IPA 直链并通知"

http:
  mitm:
    - app.iosgods.com
  script:
    - match: ^https://app\.iosgods\.com/store/api/app/[^/]+/download/sideloadly(\?.*)?$
      name: iosgods-ipa-link
      type: response
      require-body: true
      timeout: 30
      max-size: 262144

script-providers:
  iosgods-ipa-link:
    url: https://raw.githubusercontent.com/alexcz-a11y/stash-scripts/main/iosgods-ipa-link.js
    interval: 86400
